# CargoRule AI Backend Environment Configuration

# Server Port (Render/Railway sets PORT automatically)
PORT=3001
NODE_ENV=production

# Security & CORS (Set your production frontend URL)
ALLOWED_ORIGINS=https://cargorule-ai.vercel.app,http://localhost:3000
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# Production Enterprise Admin Credentials
ADMIN_EMAIL=admin@cargorule.ai
ADMIN_PASSWORD=change_this_to_a_strong_password

# OpenAI Integration (Optional: required for live GPT-4o-mini & 1536-D embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
